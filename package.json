{
  "name": "nero",
  "version": "1.0.0",
  "description": "x.com/killxnov ",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "make-setup": "electron-builder --windows nsis"
  },
  "build": {
    "appId": "com.nero.app",
    "productName": "Nero",
    "directories": {
      "output": "dist_setup"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nero"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.0.2",
    "vite": "^5.0.0"
  }
}